        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/insidegui/VMBridge.git",
      "version": {
        "branch": "main",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Scripts",
      "target-membership": [
        "VirtualInstallation",
      ],
      "membership-exceptions": [
        {
          "target": "VirtualInstallation",
          "exclusions": [
            "generate_restricted_profile.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
