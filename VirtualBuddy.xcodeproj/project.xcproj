  "targets": [
    {
      "name": "VirtualBuddy",
      "id": "F4BE9C4D27FF052100B648F8",
      "product": "Products/VirtualBuddy.app",
      "product-type": "application",
      "last-swift-migration": "13.3",
      "specialized-configurations": [
        { "name": "Beta_Debug", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/AppTarget.xcconfig" } },
        { "name": "Beta_Release", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/AppTarget.xcconfig" } },
        { "name": "Debug", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/AppTarget.xcconfig" } },
        { "name": "Debug_Managed", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/AppTarget.xcconfig" } },
        { "name": "Dev_Release", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/AppTarget.xcconfig" } },
        { "name": "Release", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/AppTarget.xcconfig" } },
        { "name": "Release_Managed", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/AppTarget.xcconfig" } },
      ],
      "dependencies": [
        "VirtualUI",
        "VirtualBuddyGuest",
        "VirtualInstallation",
        "VirtualInstallationService",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Guest App",
          "bundle-base-path": "shared-support-directory",
        }, {
          "kind": "script",
          "name": "Create Command-Line Tool Symlinks",
          "log-environment-variables": true,
          "input-paths": [
            "$(BUILT_PRODUCTS_DIR)/$(EXECUTABLE_PATH)",
          ],
          "output-paths": [
            "$(BUILT_PRODUCTS_DIR)/$(CONTENTS_FOLDER_PATH)/MacOS/vctool",
          ],
          "shell": "/bin/sh",
          "script": [
            "# Go into the VirtualBuddy.app/Contents/MacOS path",
            "cd \"$BUILT_PRODUCTS_DIR/$CONTENTS_FOLDER_PATH/MacOS\"",
            "",
            "# Symlink VirtualBuddy as vctool for VirtualCatalog command-line tool",
            "ln -fs $EXECUTABLE_NAME vctool",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Embed XPC Services",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/XPCServices",
        },
      ],
      "package-product-members": [
        {
          "product-name": "VMBridge",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "BuddyKit",
          "product-name": "BuddyFoundation",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ManagedPreferencesKit",
          "product-name": "ManagedPreferencesKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "URLQueryItemCoder",
          "product-name": "URLQueryItemCoder",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "libfragmentzip",
          "product-name": "FragmentZip",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-argument-parser",
          "product-name": "ArgumentParser",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CLANG_ENABLE_MODULES": "YES",
        "CODE_SIGN_IDENTITY[config=Beta_Debug]": "Apple Development",
        "CODE_SIGN_IDENTITY[config=Beta_Release]": "Apple Development",
        "CODE_SIGN_IDENTITY[config=Debug_Managed]": "Apple Development",
        "CODE_SIGN_IDENTITY[config=Dev_Release]": "Apple Development",
        "CODE_SIGN_IDENTITY[config=Release_Managed]": "Apple Development",
        "CODE_SIGN_STYLE[config=Beta_Debug]": "Automatic",
        "CODE_SIGN_STYLE[config=Beta_Release]": "Automatic",
        "CODE_SIGN_STYLE[config=Debug_Managed]": "Automatic",
        "CODE_SIGN_STYLE[config=Dev_Release]": "Automatic",
        "CODE_SIGN_STYLE[config=Release_Managed]": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEVELOPMENT_ASSET_PATHS": "\"VirtualBuddy/Preview Content\"",
        "DEVELOPMENT_TEAM": "8C7439RJLG",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "VirtualBuddy/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Enable audio input for your virtual machines. Without this permission, virtual machines won't be able to record any audio.",
        "LD_RUNPATH_SEARCH_PATHS": "$(VB_APP_RUNPATH_SEARCH_PATHS)",
        "OTHER_LDFLAGS": "",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(VB_BUNDLE_ID_PREFIX)codes.rambo.VirtualBuddy",
        "PROVISIONING_PROFILE_SPECIFIER[config=Beta_Debug]": "",
        "PROVISIONING_PROFILE_SPECIFIER[config=Beta_Release]": "",
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug_Managed]": "",
        "PROVISIONING_PROFILE_SPECIFIER[config=Dev_Release]": "",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release_Managed]": "",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Beta_Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug_Managed]": "-Onone",
        "SWIFT_VERSION": "5.0",
      },
    }, {
