            "Source/Resources/Preview/PreviewVirtualMachines/PreviewLinuxBlurHash.bundle": { "header-preservation": "remove-on-copy" },
            "Source/Resources/Preview/PreviewVirtualMachines/PreviewLinuxNoArtwork.bundle": { "header-preservation": "remove-on-copy" },
            "Source/Resources/Preview/PreviewVirtualMachines/PreviewMac.bundle": { "header-preservation": "remove-on-copy" },
            "Source/Resources/Preview/PreviewVirtualMachines/PreviewMacBlurHash.bundle": { "header-preservation": "remove-on-copy" },
            "Source/Resources/Preview/PreviewVirtualMachines/PreviewMacNoArtwork.bundle": { "header-preservation": "remove-on-copy" },
          },
        }, {
