    { "kind": "folder", "path": "VirtualBuddyGuestHelper", "target-membership": [ "VirtualBuddyGuestHelper" ] },
    { "kind": "folder", "path": "VirtualWormholeTests", "target-membership": [ "VirtualWormholeTests" ] },
    {
      "kind": "folder",
