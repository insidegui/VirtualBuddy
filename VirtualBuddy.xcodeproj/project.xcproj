      "name": "VirtualCore",
      "id": "F4BE9C6427FF053A00B648F8",
      "product": "Products/VirtualCore.framework",
      "product-type": "framework",
      "last-swift-migration": "15.3",
      "dependencies": [
        "VirtualWormhole",
        "VirtualInstallation",
      ],
      "build-phases": [
        "headers",
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Copy Software Catalog Feeds",
          "bundle-base-path": "resources-directory",
          "relative-path": "SoftwareCatalog",
        }, {
          "kind": "copy",
          "name": "Copy Preview Library",
          "bundle-base-path": "resources-directory",
          "relative-path": "PreviewLibrary",
        }, {
          "kind": "copy",
          "name": "Copy Preview Library Downloads",
          "bundle-base-path": "resources-directory",
          "relative-path": "PreviewLibrary/_Downloads",
        }, {
          "kind": "script",
          "name": "Strip Preview Content in Release Builds",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "scope": "install",
          "shell": "/bin/sh",
          "script": [
            "if [ \"${CONFIGURATION}\" = \"Release_Managed\" ] || [ \"${CONFIGURATION}\" = \"Dev_Release\" ] ]; then",
            "    PREVIEW_CONTENT_PATH=\"$CODESIGNING_FOLDER_PATH/Resources/PreviewLibrary\"",
            "    ",
            "    if [ -d \"$PREVIEW_CONTENT_PATH\" ]; then",
            "        echo \"Stripping VirtualCore preview content from release build at $PREVIEW_CONTENT_PATH\"",
            "        rm -r \"$PREVIEW_CONTENT_PATH\"",
            "    fi",
            "fi",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "VMBridgeVirtualization",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "BuddyKit",
          "product-name": "BuddyFoundation",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ManagedPreferencesKit",
          "product-name": "ManagedPreferencesKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CLANG_ENABLE_MODULES": "YES",
        "CODE_SIGN_IDENTITY": "",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEFINES_MODULE": "YES",
        "DEVELOPMENT_ASSET_PATHS": "VirtualCore/Source/Resources/Preview",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "ENABLE_MODULE_VERIFIER": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS": "$(VB_FRAMEWORK_RUNPATH_SEARCH_PATHS)",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGES": "objective-c objective-c++",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu11 gnu++17",
        "OTHER_LDFLAGS": "-Wl,-U,_OBJC_CLASS_$__VZVirtualMachineStartOptions",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(VB_BUNDLE_ID_PREFIX)codes.rambo.VirtualCore",
        "PRODUCT_NAME": "$(TARGET_NAME:c99extidentifier)",
        "SKIP_INSTALL": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Beta_Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug_Managed]": "-Onone",
        "SWIFT_VERSION": "5.0",
      },
