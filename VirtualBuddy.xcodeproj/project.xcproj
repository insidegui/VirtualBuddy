            "Source/Resources/Preview/_Downloads/UniversalMac_14.5_23F79_Restore.ipsw",
            "Source/Resources/Preview/_Downloads/UniversalMac_15.3_24D60_Restore.ipsw",
            "Source/Resources/Preview/_Downloads/UniversalMac_15.5_24F74_Restore.ipsw",
