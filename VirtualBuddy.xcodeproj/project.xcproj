{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Beta_Debug", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/Main.xcconfig" } },
    { "name": "Beta_Release", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/Main.xcconfig" } },
    { "name": "Debug", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/Main.xcconfig" } },
    { "name": "Debug_Managed", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/Main.xcconfig" } },
    { "name": "Dev_Release", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/Main.xcconfig" } },
    { "name": "Release", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/Main.xcconfig" } },
    { "name": "Release_Managed", "file": { "anchor": "VirtualBuddy", "relative-path": "Config/Main.xcconfig" } },
