      "kind": "remote",
      "repository": "https://github.com/kylehughes/URLQueryItemCoder.git",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/siteline/swiftui-introspect",
      "version": {
        "version": "27.0.0-beta.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/insidegui/BuddyKit",
